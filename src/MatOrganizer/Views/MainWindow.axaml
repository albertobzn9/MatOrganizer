<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MatOrganizer.Views.MainWindow"
        Title="MatOrganizer"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="26" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5">
        <TextBlock FontSize="30" FontWeight="SemiBold" Text="MatOrganizer" />
        <TextBlock x:Name="SubtitleText"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </StackPanel>
      <ToggleButton x:Name="LanguageToggleButton"
                    Grid.Column="1"
                    Padding="12,8"
                    IsCheckedChanged="LanguageToggleButton_IsCheckedChanged">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
          <TextBlock x:Name="EnglishLanguageText" Text="Eng" />
          <TextBlock x:Name="SpanishLanguageText" Grid.Column="1" Text="Esp" />
        </Grid>
      </ToggleButton>
    </Grid>

    <Border Grid.Row="1"
            Padding="14"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="16">
      <Border x:Name="UnassignedDropZone"
              Padding="12"
              Background="{DynamicResource SystemControlHighlightAltLowBrush}"
              BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <TextBlock x:Name="UnassignedTitleText" FontWeight="SemiBold" />
          <ListBox x:Name="UnassignedListBox"
                   Grid.Row="1"
                   SelectionChanged="UnassignedListBox_SelectionChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="9,7" />
              </Style>
            </ListBox.Styles>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="AddLabelText" VerticalAlignment="Center" />
              <ComboBox x:Name="InputFileTypeComboBox"
                        Width="90"
                        SelectedIndex="0"
                        SelectionChanged="InputFileTypeComboBox_SelectionChanged">
                <ComboBoxItem Content=".mat" />
                <ComboBoxItem Content=".mp4" />
                <ComboBoxItem Content=".mkv" />
              </ComboBox>
            </StackPanel>
            <Button x:Name="SelectFilesButton" Click="SelectFilesButton_Click" />
            <Button x:Name="DeselectButton" Click="DeselectButton_Click" />
            <Button x:Name="RemoveButton" Click="RemoveButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="DaysLabelText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox x:Name="DayCountTextBox" Width="55" Text="10" />
            <TextBlock x:Name="RatsLabelText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox x:Name="RatCountTextBox" Width="55" Text="1" />
            <Button x:Name="UpdateGridButton" Click="UpdateGridButton_Click" />
            <TextBlock x:Name="MonthYearLabelText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox x:Name="MonthYearTextBox"
                     Width="70"
                     Background="{DynamicResource SystemControlHighlightAltLowBrush}"
                     PlaceholderText="01-26"
                     TextChanged="NamingOption_Changed" />
            <TextBlock x:Name="PhaseLabelText" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox x:Name="PhaseComboBox"
                      Width="76"
                      SelectedIndex="0"
                      SelectionChanged="NamingOption_Changed">
              <ComboBoxItem Content="cs" />
              <ComboBoxItem Content="cp" />
              <ComboBoxItem Content="dis" />
            </ComboBox>
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <Grid x:Name="AssignmentGrid" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="CopyLabelText" VerticalAlignment="Center" FontWeight="SemiBold" />
        <CheckBox x:Name="CopyMatCheckBox" IsChecked="True" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mat" />
        <CheckBox x:Name="CopyMp4CheckBox" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mp4" />
        <CheckBox x:Name="CopyMkvCheckBox" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mkv" />
      </StackPanel>
      <TextBlock x:Name="OutputFolderText"
                 Grid.Row="1"
                 VerticalAlignment="Center"
                 />
      <Button x:Name="ChooseOutputFolderButton" Grid.Row="1" Grid.Column="1" Click="ChooseOutputFolderButton_Click" />
      <Button x:Name="CreateButton"
              Grid.Row="1"
              Grid.Column="2"
              Click="CreateButton_Click" />
      <TextBlock x:Name="StatusText"
                 Grid.Row="2"
                 Grid.ColumnSpan="3"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <StackPanel x:Name="ProgressPanel" Grid.Row="3" Grid.ColumnSpan="3" Spacing="4" IsVisible="False">
        <TextBlock x:Name="CurrentFileProgressText" TextWrapping="Wrap" />
        <ProgressBar x:Name="CurrentFileProgressBar" Height="18" Minimum="0" Maximum="100" ShowProgressText="True" ProgressTextFormat="{}{1:0}%" />
        <TextBlock x:Name="TotalProgressText" TextWrapping="Wrap" />
        <ProgressBar x:Name="TotalProgressBar" Height="18" Minimum="0" Maximum="100" ShowProgressText="True" ProgressTextFormat="{}{1:0}%" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
