<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MatOrganizer.MainWindow"
        Title="MatOrganizer"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="26" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <StackPanel Spacing="5">
      <TextBlock FontSize="30" FontWeight="SemiBold" Text="MatOrganizer" />
      <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 Text="Organiza sesiones por día y rata, crea copias .mat, .mp4 o .mkv con un nombre estándar y genera su relación en Excel." />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="14"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock TextWrapping="Wrap"
                 Text="1. Elige el tipo de archivo y cárgalo.  2. Selecciona un archivo de la lista y haz clic en su celda Día–Rata.  3. Indica mes-año, fase, tipos a copiar y una carpeta de salida. Los originales nunca se modifican." />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="16">
      <Border x:Name="UnassignedDropZone"
              Padding="12"
              Background="{DynamicResource SystemControlHighlightAltLowBrush}"
              BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <TextBlock x:Name="UnassignedTitleText" FontWeight="SemiBold" Text="Sin asignar" />
          <ListBox x:Name="UnassignedListBox"
                   Grid.Row="1"
                   SelectionChanged="UnassignedListBox_SelectionChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="9,7" />
              </Style>
            </ListBox.Styles>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center" Text="Agregar:" />
              <ComboBox x:Name="InputFileTypeComboBox"
                        Width="90"
                        SelectedIndex="0"
                        SelectionChanged="InputFileTypeComboBox_SelectionChanged">
                <ComboBoxItem Content=".mat" />
                <ComboBoxItem Content=".mp4" />
                <ComboBoxItem Content=".mkv" />
              </ComboBox>
            </StackPanel>
            <Button x:Name="SelectFilesButton" Click="SelectFilesButton_Click" Content="Agregar archivos .mat…" />
            <Button x:Name="DeselectButton" Click="DeselectButton_Click" Content="Deseleccionar" />
            <Button x:Name="RemoveButton" Click="RemoveButton_Click" Content="Quitar de la lista" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Días:" />
            <TextBox x:Name="DayCountTextBox" Width="55" Text="10" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Ratas:" />
            <TextBox x:Name="RatCountTextBox" Width="55" Text="1" />
            <Button Click="UpdateGridButton_Click" Content="Actualizar cuadrícula" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Mes-año:" />
            <TextBox x:Name="MonthYearTextBox"
                     Width="70"
                     Background="{DynamicResource SystemControlHighlightAltLowBrush}"
                     PlaceholderText="01-26"
                     TextChanged="NamingOption_Changed" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Fase:" />
            <ComboBox x:Name="PhaseComboBox"
                      Width="76"
                      SelectedIndex="0"
                      SelectionChanged="NamingOption_Changed">
              <ComboBoxItem Content="dis" />
              <ComboBoxItem Content="C" />
              <ComboBoxItem Content="S" />
              <ComboBoxItem Content="CP" />
            </ComboBox>
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <Grid x:Name="AssignmentGrid" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Copiar:" />
        <CheckBox x:Name="CopyMatCheckBox" IsChecked="True" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mat" />
        <CheckBox x:Name="CopyMp4CheckBox" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mp4" />
        <CheckBox x:Name="CopyMkvCheckBox" IsCheckedChanged="CopyOption_IsCheckedChanged" Content=".mkv" />
      </StackPanel>
      <TextBlock x:Name="OutputFolderText"
                 Grid.Row="1"
                 VerticalAlignment="Center"
                 Text="Carpeta de salida: sin seleccionar" />
      <Button Grid.Row="1" Grid.Column="1" Click="ChooseOutputFolderButton_Click" Content="Seleccionar folder final" />
      <Button x:Name="CreateButton"
              Grid.Row="1"
              Grid.Column="2"
              Click="CreateButton_Click"
              Content="Crear copias y Excel" />
      <TextBlock x:Name="StatusText"
                 Grid.Row="2"
                 Grid.ColumnSpan="3"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <StackPanel x:Name="ProgressPanel" Grid.Row="3" Grid.ColumnSpan="3" Spacing="4" IsVisible="False">
        <TextBlock x:Name="CurrentFileProgressText" TextWrapping="Wrap" />
        <ProgressBar x:Name="CurrentFileProgressBar" Height="18" Minimum="0" Maximum="100" ShowProgressText="True" ProgressTextFormat="{}{1:0}%" />
        <TextBlock x:Name="TotalProgressText" TextWrapping="Wrap" />
        <ProgressBar x:Name="TotalProgressBar" Height="18" Minimum="0" Maximum="100" ShowProgressText="True" ProgressTextFormat="{}{1:0}%" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
